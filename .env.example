# Konfigurasi Akun Gmail Pengirim (Gunakan Google App Password 16 karakter tanpa spasi)
GMAIL_USERNAME=emailanda@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop
EMAIL_PENERIMA=emailpenerima@gmail.com

# Konfigurasi RabbitMQ Broker (Default Docker)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

