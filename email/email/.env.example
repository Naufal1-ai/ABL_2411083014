# ============================================================
# TEMPLATE KONFIGURASI (AMAN UNTUK DI-PUSH KE GITHUB)
#
# Cara pakai:
#   1. Copy file ini menjadi ".env"
#   2. Isi nilainya dengan data asli Anda
#   3. File ".env" sudah otomatis di-gitignore (tidak akan ke-push)
# ============================================================

# Akun Gmail pengirim (yang punya App Password)
GMAIL_USERNAME=EMAIL_GMAIL_ANDA@gmail.com

# App Password Gmail (16 karakter, dari https://myaccount.google.com/apppasswords)
GMAIL_APP_PASSWORD=APP_PASSWORD_16_KARAKTER

# Email tujuan notifikasi (boleh sama dengan GMAIL_USERNAME)
EMAIL_PENERIMA=EMAIL_TUJUAN@gmail.com

# (Opsional) Konfigurasi RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
